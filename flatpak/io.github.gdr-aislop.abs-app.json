{
    "app-id": "io.github.gdr-aislop.abs-app",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "abs-app",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--system-talk-name=org.freedesktop.ModemManager1",
        "--own-name=org.mpris.MediaPlayer2.abs-app"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gtk-doc",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "gstreamer-plugins",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgood=enabled",
                "-Dugly=disabled",
                "-Dbad=disabled",
                "-Dlibav=enabled",
                "-Ddoc=disabled",
                "-Dexamples=disabled",
                "-Dtests=disabled",
                "-Dgood:pulse=enabled",
                "-Dgood:soup=enabled",
                "-Dlibav:default-visualizer=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.freedesktop.org/gstreamer/gstreamer.git",
                    "tag": "1.22.11",
                    "commit": "e49b86e82ee5521e7edf62113b482368e72f9cf2"
                }
            ]
        },
        {
            "name": "abs-app",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --release -p abs-app",
                "install -Dm755 target/release/abs-app /app/bin/abs-app",
                "install -Dm644 app/assets/abs-app.desktop /app/share/applications/abs-app.desktop",
                "install -Dm644 app/assets/abs-app.svg /app/share/icons/hicolor/scalable/apps/abs-app.svg",
                "install -Dm644 app/assets/io.github.gdr-aislop.abs-app.metainfo.xml /app/share/metainfo/io.github.gdr-aislop.abs-app.metainfo.xml",
                "install -Dm644 LICENSE /app/share/doc/abs-app/LICENSE"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                },
                "cargo-sources.json"
            ]
        }
    ]
}
