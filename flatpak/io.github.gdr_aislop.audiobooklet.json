{
    "app-id": "io.github.gdr_aislop.audiobooklet",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "audiobooklet",
    "separate-locales": false,
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--system-talk-name=org.freedesktop.ModemManager1",
        "--talk-name=org.freedesktop.secrets",
        "--own-name=org.mpris.MediaPlayer2.audiobooklet"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gtk-doc",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "audiobooklet",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --release -p audiobooklet",
                "install -Dm755 target/release/audiobooklet /app/bin/audiobooklet",
                "scripts/build-l10n.sh build/l10n",
                "install -Dm644 build/l10n/io.github.gdr_aislop.audiobooklet.desktop /app/share/applications/io.github.gdr_aislop.audiobooklet.desktop",
                "install -Dm644 app/assets/io.github.gdr_aislop.audiobooklet.svg /app/share/icons/hicolor/scalable/apps/io.github.gdr_aislop.audiobooklet.svg",
                "install -Dm644 build/l10n/io.github.gdr_aislop.audiobooklet.metainfo.xml /app/share/metainfo/io.github.gdr_aislop.audiobooklet.metainfo.xml",
                "mkdir -p /app/share/locale && cp -a build/l10n/locale/. /app/share/locale/",
                "install -Dm644 LICENSE /app/share/doc/audiobooklet/LICENSE"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                },
                "cargo-sources.json"
            ],
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/audiobooklet/cargo"
                }
            }
        }
    ]
}
