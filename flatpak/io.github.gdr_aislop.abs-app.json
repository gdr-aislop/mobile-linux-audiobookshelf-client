{
    "app-id": "io.github.gdr_aislop.abs-app",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "abs-app",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=pulseaudio",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--system-talk-name=org.freedesktop.ModemManager1",
        "--talk-name=org.freedesktop.secrets",
        "--own-name=org.mpris.MediaPlayer2.abs-app"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/gtk-doc",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "abs-app",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --release -p abs-app",
                "install -Dm755 target/release/abs-app /app/bin/abs-app",
                "install -Dm644 app/assets/io.github.gdr_aislop.abs-app.desktop /app/share/applications/io.github.gdr_aislop.abs-app.desktop",
                "install -Dm644 app/assets/io.github.gdr_aislop.abs-app.svg /app/share/icons/hicolor/scalable/apps/io.github.gdr_aislop.abs-app.svg",
                "install -Dm644 app/assets/io.github.gdr_aislop.abs-app.metainfo.xml /app/share/metainfo/io.github.gdr_aislop.abs-app.metainfo.xml",
                "install -Dm644 LICENSE /app/share/doc/abs-app/LICENSE"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                },
                "cargo-sources.json"
            ],
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/abs-app/cargo"
                }
            }
        }
    ]
}
