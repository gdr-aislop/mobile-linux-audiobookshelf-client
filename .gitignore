/target
/build

# Cargo.lock is intentionally committed (this is an application, not a library)

# vendor/ is reserved for `cargo vendor` output used by the offline Debian build;
# it is regenerated as part of producing the packaging source, not committed here.
/vendor/

# Generated by scripts/gen-flatpak-cargo-sources.sh from Cargo.lock, right before a Flatpak
# build; regenerated fresh every time so it can't go stale, hence not committed.
/flatpak/cargo-sources.json

# local/dev SQLite databases, if any land in-tree
*.sqlite3
*.sqlite3-journal

# editor/OS cruft
.DS_Store
*.swp
